# Environment. 308 MB of third-party code; `requirements.txt` is the protocol.
venv/

# Byte-compiled output.
__pycache__/
*.pyc

# Editor and OS droppings. The two stale vim swap files in this tree are the
# user's; ignored, not deleted.
.DS_Store
*.swp

# Machine-local permission settings, not project protocol.
.claude/settings.local.json

# Run output, not protocol. `runs/` is captured child stdout, `eval/results/` is
# grid measurement data and `eval/calibration/` is the D8 sweep's draws. All three
# are *outputs of* the thing this repository freezes, and committing them alongside
# the protocol destroys the one property the pre-registration exists to have: that
# the protocol provably predates the data. Data gets committed deliberately and
# separately, once it exists. `eval/calibration/` was missing here while
# `eval/results/` was listed, though the reasoning is the same for both and the
# calibration is the sweep that decides whether the grid runs at all.
runs/
eval/results/
eval/calibration/
memory.json

# Run output from the 2026-09-02/03 sweeps. Same rule as runs/ above: these are
# outputs of the thing this repository freezes. The protocol must provably
# predate the data, so data is never committed in the same tree as the protocol.
*.log
decoy_run_2026-09-02/
probe_rpd_*.json
